#N canvas 6 40 1000 700 8;
#X text 20 10 MIDI sample player -- cluster 5 (09_D4 / 14_Bb4 / 01_C3);
#X obj 20 640 loadbang;
#X msg 20 670 \; pd dsp 1;
#X obj 20 100 poly 4 1;
#X obj 20 150 pack f f f;
