#N canvas 30 40 1320 900 10;
#X text 30 20 Bog Music -- ambient bed + idle-mode soundscape layer (ported from the TouchDesigner project).;
#X text 30 40 Standalone patch for its own device. Receives /activity OSC from the 6 cluster patches on UDP 9000.;
#X text 30 62 Ambient bed loops forever at a fixed level. Idle mode fades in when no /activity arrives for the timeout / fades out fast when it resumes / and layers on top of the bed.;
#X obj 30 110 loadbang;
#X msg 30 140 \; pd dsp 1;
#X text 30 190 AMBIENT BED -- streamed from disk with readsf~ / relooped on end-of-file;
#X obj 30 220 loadbang;
#X obj 30 250 t b b;
#X msg 210 250 open soundscapes/bog_ambient_base.wav;
#X msg 470 250 1;
#X obj 30 300 readsf~ 2;
#X obj 30 410 *~ 0.5;
#X obj 130 410 *~ 0.5;
#X obj 30 345 t b b;
#X text 250 342 <- reloop on end-of-file;
#X floatatom 340 372 7 0 0 0 - - - 0;
#X obj 340 342 loadbang;
#X msg 340 402 0.5;
#X text 410 374 ambient level (fixed);
#X text 30 460 IDLE MODE LAYER -- envelope-gated / relooped while idle;
#X obj 30 500 readsf~ 2;
#X msg 210 500 open soundscapes/bog_idle_mode.wav;
#X msg 490 500 1;
#X msg 530 500 0;
#X obj 30 620 *~;
#X obj 130 620 *~;
#X obj 30 560 line~;
#X obj 30 690 dac~ 1 2;
#X text 620 190 fade-in (ms);
#X floatatom 620 215 8 0 0 0 - - - 0;
#X obj 790 215 loadbang;
#X msg 790 245 4000;
#X text 620 300 fade-out (ms);
#X floatatom 620 325 8 0 0 0 - - - 0;
#X obj 790 325 loadbang;
#X msg 790 355 400;
#X text 620 410 idle timeout (ms);
#X floatatom 620 435 8 0 0 0 - - - 0;
#X obj 790 435 loadbang;
#X msg 790 465 60000;
#X msg 340 520 1;
#X obj 340 590 pack f f;
#X msg 440 520 0;
#X obj 440 590 pack f f;
#X obj 540 620 + 200;
#X obj 540 650 del 600;
#X text 880 150 IDLE STATE MACHINE -- the 6 cluster patches must point their "connect <ip> 9000" box at THIS device;
#X obj 880 220 netreceive -u -b 9000;
#X obj 880 250 oscparse;
#X obj 880 280 list trim;
#X obj 880 310 route activity;
#X obj 880 345 t b b;
#X obj 880 395 del 60000;
#X obj 880 440 t b b b b;
#X msg 880 490 1;
#X obj 880 520 s idle-active;
#X obj 1080 345 spigot 0;
#X obj 1080 312 r idle-active;
#X obj 1080 400 t b b b;
#X msg 1080 450 0;
#X obj 1080 480 s idle-active;
#X obj 760 560 loadbang;
#X msg 760 590 0;
#X obj 760 620 s idle-active;
#X obj 210 800 spigot 0;
#X obj 210 830 t b b;
#X text 30 770 Idle EOF reloop -- keeps the idle layer going while still idle;
#X obj 380 800 r idle-active;
